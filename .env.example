APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Pilih salah satu sesuai environment:
# - Local              : http://127.0.0.1:8000
# - Ngrok (dev tunnel) : https://xxxxx.ngrok-free.app
# - Production         : https://your-domain.com
# Midtrans webhook & redirect URLs di file ini auto-mengikuti APP_URL.
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Trusted proxies. Set "*" jika di belakang ngrok / Railway / Cloudflare.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ============================================
# RAJAONGKIR
# ============================================
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_DISTRICT_ID=
RAJAONGKIR_MIN_WEIGHT=50

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# false = Sandbox, true = Production
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Callback URLs auto-mengikuti APP_URL.
# Saat pakai ngrok, cukup ubah APP_URL ke URL ngrok-nya, lalu update
# Notification URL di Midtrans Dashboard ke ${APP_URL}/midtrans/notification
MIDTRANS_NOTIFICATION_URL="${APP_URL}/midtrans/notification"
MIDTRANS_FINISH_URL="${APP_URL}/payment/success"
MIDTRANS_UNFINISH_URL="${APP_URL}/payment/unfinish"
MIDTRANS_ERROR_URL="${APP_URL}/payment/error"

# ============================================
# GOOGLE OAUTH (Login dengan Google)
# ============================================
# Buat OAuth Client ID di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ============================================
# CLINIC INFO (header & footer email, invoice)
# ============================================
CLINIC_NAME="Aishi Beauty"
CLINIC_TAGLINE="Beauty Clinic & Skincare"
CLINIC_DISTRICT=Beji
CLINIC_CITY="Kota Depok"
CLINIC_PROVINCE="Jawa Barat"
CLINIC_ADDRESS="Jl. Nusantara Raya No.99b, Beji, Kec. Beji, Kota Depok, Jawa Barat 16421"
CLINIC_ADDRESS_SHORT="Jl. Nusantara Raya No.99b, Kota Depok"
CLINIC_EMAIL=aishibeauty.byels@gmail.com
CLINIC_PHONE="(021) 2956-9090"
CLINIC_WHATSAPP="+62 851-2627-2273"
CLINIC_INSTAGRAM="@aishibeauty.bydrels"

# ============================================
# FONNTE WHATSAPP API
# ============================================
# Token diperoleh dari https://md.fonnte.com (Device → API)
# Biarkan FONNTE_TOKEN kosong di environment yang tidak butuh kirim WA
# (mis. testing) — service akan otomatis skip request.
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
